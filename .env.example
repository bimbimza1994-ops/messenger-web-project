PORT=3000
# Set this to a long random string before deploying.
ADMIN_KEY=change-me-to-a-long-random-admin-key
# Used to encrypt the Messenger Page Access Token stored by Settings.
MASTER_KEY=change-me-to-a-32-byte-secret
# Optional: pin the Graph API version you want to use, e.g. v24.0
GRAPH_API_VERSION=v24.0
